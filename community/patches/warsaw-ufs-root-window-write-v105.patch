diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -3048,6 +3048,80 @@ static int ufshcd_init_cmd_priv(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 	return 0;
 }
 
+#define WARSAW_ROOT_FIRST_LBA	32815360ULL
+#define WARSAW_ROOT_LAST_LBA	62112234ULL
+
+static bool ufshcd_warsaw_root_window_write(struct scsi_cmnd *cmd)
+{
+	sector_t lba;
+	unsigned int blocks;
+
+	if (cmd->device->lun != 0)
+		return false;
+	if (cmd->cmnd[0] != WRITE_10 && cmd->cmnd[0] != WRITE_16)
+		return false;
+
+	lba = scsi_get_lba(cmd);
+	blocks = scsi_logical_block_count(cmd);
+	if (!blocks || lba < WARSAW_ROOT_FIRST_LBA ||
+	    lba > WARSAW_ROOT_LAST_LBA)
+		return false;
+	return blocks <= WARSAW_ROOT_LAST_LBA - lba + 1;
+}
+
+static bool ufshcd_warsaw_command_may_modify_media(struct scsi_cmnd *cmd)
+{
+	if (ufshcd_warsaw_root_window_write(cmd))
+		return false;
+	if (cmd->device->lun == 0 &&
+	    (cmd->cmnd[0] == SYNCHRONIZE_CACHE ||
+	     cmd->cmnd[0] == SYNCHRONIZE_CACHE_16))
+		return false;
+	if (cmd->sc_data_direction == DMA_TO_DEVICE ||
+	    cmd->sc_data_direction == DMA_BIDIRECTIONAL ||
+	    cmd->cmnd[0] >= VENDOR_SPECIFIC_CDB)
+		return true;
+
+	switch (cmd->cmnd[0]) {
+	case FORMAT_UNIT:
+	case REASSIGN_BLOCKS:
+	case WRITE_6:
+	case MODE_SELECT:
+	case ERASE:
+	case SEND_DIAGNOSTIC:
+	case WRITE_10:
+	case WRITE_VERIFY:
+	case SYNCHRONIZE_CACHE:
+	case WRITE_BUFFER:
+	case UPDATE_BLOCK:
+	case WRITE_LONG:
+	case WRITE_SAME:
+	case UNMAP:
+	case LOG_SELECT:
+	case XDWRITEREAD_10:
+	case MODE_SELECT_10:
+	case PERSISTENT_RESERVE_OUT:
+	case VARIABLE_LENGTH_CMD:
+	case ACCESS_CONTROL_OUT:
+	case COMPARE_AND_WRITE:
+	case WRITE_16:
+	case WRITE_ATTRIBUTE:
+	case WRITE_VERIFY_16:
+	case SYNCHRONIZE_CACHE_16:
+	case WRITE_SAME_16:
+	case ZBC_OUT:
+	case WRITE_ATOMIC_16:
+	case MAINTENANCE_OUT:
+	case WRITE_12:
+	case WRITE_VERIFY_12:
+	case SECURITY_PROTOCOL_OUT:
+	case WRITE_LONG_2:
+		return true;
+	default:
+		return false;
+	}
+}
