--- a/arch/arm64/boot/dts/qcom/sm8750-xiaomi-warsaw.dts
+++ b/arch/arm64/boot/dts/qcom/sm8750-xiaomi-warsaw.dts
@@ -203,13 +203,22 @@
 };
 
 &usb {
-	status = "disabled";
+	/delete-property/ phys;
+	/delete-property/ phy-names;
+	/delete-property/ usb-role-switch;
+
+	phys = <&usb_hsphy>;
+	phy-names = "usb2-phy";
+	dr_mode = "peripheral";
+	maximum-speed = "high-speed";
+	qcom,select-utmi-as-pipe-clk;
+	status = "okay";
 };
 
 &usb_dp_qmpphy {
 	status = "disabled";
 };
 
 &usb_hsphy {
-	status = "disabled";
+	status = "okay";
 };
