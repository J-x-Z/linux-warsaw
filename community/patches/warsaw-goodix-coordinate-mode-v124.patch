+static int goodix_berlin_send_cmd(struct goodix_berlin_core *cd, u8 command,
+				  const u8 *data, size_t data_len)
+{
+	u8 tx[GOODIX_BERLIN_CMD_SIZE] = {};
+	u8 rx[GOODIX_BERLIN_CMD_SIZE];
+	u16 checksum = 0;
+	int error, poll, retry;
+	size_t i;
+
+	if (!cd->cmd_addr || data_len > sizeof(tx) - 8)
+		return -EINVAL;
+
+	tx[2] = data_len + 4;
+	tx[3] = command;
+	memcpy(&tx[4], data, data_len);
+
+	for (i = 2; i < tx[2]; i++)
+		checksum += tx[i];
+	put_unaligned_le16(checksum, &tx[tx[2]]);
+
+	for (retry = 0; retry < GOODIX_BERLIN_CMD_RETRY; retry++) {
+		error = regmap_raw_write(cd->regmap, cd->cmd_addr, tx, sizeof(tx));
+		if (error)
+			return error;
+
+		for (poll = 0; poll < GOODIX_BERLIN_CMD_RETRY; poll++) {
+			error = regmap_raw_read(cd->regmap, cd->cmd_addr, rx,
+						sizeof(rx));
+			if (error)
+				return error;
+
+			if (rx[1] == GOODIX_BERLIN_CMD_ACK_OK) {
+				usleep_range(4000, 4100);
+				return 0;
+			}
+
+			if (!rx[1] || rx[1] == GOODIX_BERLIN_CMD_ACK_BUSY) {
+				usleep_range(1000, 1100);
+				continue;
+			}
+
+			if (rx[1] == GOODIX_BERLIN_CMD_ACK_BUFFER_OVERFLOW)
+				usleep_range(10000, 11000);
+
+			break;
+		}
+	}
+
+	dev_err(cd->dev, "command 0x%02x failed, last ack 0x%02x\n",
+		command, rx[1]);
+	return -EINVAL;
+}
+
+static int goodix_berlin_set_coordinate_mode(struct goodix_berlin_core *cd)
+{
+	static const u8 frame_data[] = {
+		GOODIX_BERLIN_FRAME_DATA_DIFF,
+		GOODIX_BERLIN_FRAME_DATA_DISABLE,
+	};
+	static const u8 touch_data[] = {
+		GOODIX_BERLIN_TOUCH_DATA_AUTO_SYNC,
+	};
+	int error;
+
+	if (!cd->coordinate_mode)
+		return 0;
+
+	error = goodix_berlin_send_cmd(cd, GOODIX_BERLIN_CMD_FRAME_DATA,
+				       frame_data, sizeof(frame_data));
+	if (error)
+		return error;
+
+	error = goodix_berlin_send_cmd(cd, GOODIX_BERLIN_CMD_TOUCH_DATA,
+				       touch_data, sizeof(touch_data));
+	if (error)
+		return error;
+
+	dev_info(cd->dev, "standard coordinate reporting enabled\n");
+	return 0;
+}
