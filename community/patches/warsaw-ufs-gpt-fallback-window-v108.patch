diff --git a/drivers/ufs/core/ufshcd.c b/drivers/ufs/core/ufshcd.c
--- a/drivers/ufs/core/ufshcd.c
+++ b/drivers/ufs/core/ufshcd.c
@@ -3050,6 +3050,35 @@ static int ufshcd_init_cmd_priv(struct Scsi_Host *host, struct scsi_cmnd *cmd)
 
 #define WARSAW_ROOT_FIRST_LBA	32815360ULL
 #define WARSAW_ROOT_LAST_LBA	62112234ULL
+#define WARSAW_LUN4_LAST_LBA	504831ULL
+
+static bool ufshcd_warsaw_gpt_window_write(struct scsi_cmnd *cmd)
+{
+	sector_t lba;
+	sector_t last_lba;
+	unsigned int blocks;
+	unsigned int primary_last;
+	unsigned int backup_entries_first;
+	unsigned int backup_entries_last;
+
+	if (cmd->cmnd[0] != WRITE_10 && cmd->cmnd[0] != WRITE_16)
+		return false;
+	if (cmd->device->lun != 4)
+		return false;
+	last_lba = WARSAW_LUN4_LAST_LBA;
+	primary_last = 4;
+	backup_entries_first = WARSAW_LUN4_LAST_LBA - 6;
+	backup_entries_last = WARSAW_LUN4_LAST_LBA - 4;
+
+	lba = scsi_get_lba(cmd);
+	blocks = scsi_logical_block_count(cmd);
+	if (!blocks || lba > last_lba || blocks - 1 > last_lba - lba)
+		return false;
+	return (lba >= 1 && lba + blocks - 1 <= primary_last) ||
+	       (lba >= backup_entries_first &&
+		lba + blocks - 1 <= backup_entries_last) ||
+	       (lba == last_lba && blocks == 1);
+}
 
